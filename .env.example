# Copy to .env beside docker-compose.yml (never commit .env).
# Pushover alerts: an application's API token and your user key, both from
# pushover.net. Leave empty to turn alerts off.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Optional: opened when a notification is tapped, e.g. the dashboard's address.
ALERT_LINK=
# Optional: pinged every minute while the checks run. A dead man's switch
# such as a Healthchecks.io check alerts when the pings stop.
HEARTBEAT_URL=
